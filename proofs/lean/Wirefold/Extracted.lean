def float_core.strip_zeros
  (m : Std.U64) (e : Std.I32) : Result (Std.U64 × Std.I32) := do
  let i ← m % 10000000000000000#u64
  let (m1, e1) ←
    if i = 0#u64
    then
      do
      let m2 ← m / 10000000000000000#u64
      let e2 ← e + 16#i32
      ok (m2, e2)
    else ok (m, e)
  let i1 ← m1 % 100000000#u64
  let (m2, e2) ←
    if i1 = 0#u64
    then do
         let m3 ← m1 / 100000000#u64
         let e3 ← e1 + 8#i32
         ok (m3, e3)
    else ok (m1, e1)
  let i2 ← m2 % 10000#u64
  let (m3, e3) ←
    if i2 = 0#u64
    then do
         let m4 ← m2 / 10000#u64
         let e4 ← e2 + 4#i32
         ok (m4, e4)
    else ok (m2, e2)
  let i3 ← m3 % 100#u64
  let (m4, e4) ←
    if i3 = 0#u64
    then do
         let m5 ← m3 / 100#u64
         let e5 ← e3 + 2#i32
         ok (m5, e5)
    else ok (m3, e3)
  let i4 ← m4 % 10#u64
  if i4 = 0#u64
  then let m5 ← m4 / 10#u64
       let e5 ← e4 + 1#i32
       ok (m5, e5)
  else ok (m4, e4)

/-- [wirefold_extract::float_core::shortest]:
    Source: '../../src/num/float_core.rs', lines 63:0-114:1
    Visibility: public -/
def float_core.shortest
  (c : Std.U64) (q : Std.I32) (c_min : Std.U64) (q_min : Std.I32)
  (tie_even : Bool) :
  Result (Std.U64 × Std.I32)
  := do
  let out ← lift (c &&& 1#u64)
  let cb ← c <<< 2#i32
  let cbr ← cb + 2#u64
  let (regular, cbl) ←
    if (c != c_min) || (q = q_min)
    then do
         let cbl1 ← cb - 2#u64
         ok (true, cbl1)
    else do
         let cbl1 ← cb - 1#u64
         ok (false, cbl1)
  let k ←
    if regular
    then float_core.flog10_pow2 q
    else float_core.flog10_three_quarters_pow2 q
  let i ← -. k
  let i1 ← float_core.flog2_pow10 i
  let i2 ← q + i1
  let h ← i2 + 1#i32
  let i3 ← i - float_tables.J_MIN
  let i4 ← lift (IScalar.hcast .Usize i3)
  let gi ← i4 * 2#usize
  let i5 ← Array.index_usize float_tables.G gi
  let i6 ← gi + 1#usize
  let i7 ← Array.index_usize float_tables.G i6
  let i8 ← Array.index_usize (Array.make 2#usize [ i5, i7 ]) 0#usize
  let i9 ← lift (UScalar.cast .U128 i8)
  let i10 ← i9 <<< 64#i32
  let i11 ← Array.index_usize (Array.make 2#usize [ i5, i7 ]) 1#usize
  let i12 ← lift (UScalar.cast .U128 i11)
  let g_over ← lift (i10 ||| i12)
  let i13 ←
    lift (UScalar.cast_fromBool .U128 ((k < (-53)#i32) || (k > 0#i32)))
  let g_under ← g_over - i13
  let (closed, g_lo) ←
    if out = 0#u64
    then ok (true, g_under)
    else ok (false, g_over)
  let g_hi ← if closed
               then ok g_over
               else ok g_under
  let i14 ← cb <<< h
  let vb ← float_core.rop i8 i11 i14
  let i15 ← g_lo >>> 64#i32
  let i16 ← lift (UScalar.cast .U64 i15)
  let i17 ← lift (UScalar.cast .U64 g_lo)
  let i18 ← cbl <<< h
  let vbl ← float_core.rop i16 i17 i18
  let i19 ← g_hi >>> 64#i32
  let i20 ← lift (UScalar.cast .U64 i19)
  let i21 ← lift (UScalar.cast .U64 g_hi)
  let i22 ← cbr <<< h
  let vbr ← float_core.rop i20 i21 i22
  let s ← vb >>> 2#i32
  let i23 ← s / 10#u64
  let sp10 ← 10#u64 * i23
  let tp10 ← sp10 + 10#u64
  let i24 ← vbl + out
  let i25 ← sp10 <<< 2#i32
  let i26 ← tp10 <<< 2#i32
  let i27 ← i26 + out
  if (i24 <= i25) != (i27 <= vbr)
  then
    let sp101 ← if i24 <= i25
                  then ok sp10
                  else ok tp10
    float_core.strip_zeros sp101 k
  else
    let t ← s + 1#u64
    let i28 ← s <<< 2#i32
    let i29 ← t <<< 2#i32
    let i30 ← i29 + out
    if (i24 <= i28) != (i30 <= vbr)
    then if i24 <= i28
         then ok (s, k)
         else ok (t, k)
    else
      let i31 ← s + t
      let twice ← i31 <<< 1#i32
      if vb < twice
      then ok (s, k)
      else
        if vb = twice
        then
          if tie_even
          then
            let i32 ← lift (s &&& 1#u64)
            if i32 = 0#u64
            then ok (s, k)
            else ok (t, k)
          else ok (t, k)
        else ok (t, k)

