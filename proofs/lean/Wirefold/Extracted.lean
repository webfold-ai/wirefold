def itoa_core.digit_count (v : Std.U64) : Result Std.Usize := do
  let x ← if v = 0#u64
            then ok 1#u64
            else ok v
  let i ← lift (core.num.U64.leading_zeros x)
  let i1 ← lift (UScalar.cast .Usize i)
  let bits ← 64#usize - i1
  let i2 ← bits * 1233#usize
  let t ← i2 >>> 12#i32
  let i3 ← t + 1#usize
  let i4 ← Array.index_usize itoa_core.POW10 t
  let i5 ← lift (UScalar.cast_fromBool .Usize (x < i4))
  i3 - i5

