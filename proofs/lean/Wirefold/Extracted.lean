  (buf : Array Std.U8 40#usize) (v : Std.U64) :
  Result (Std.Usize × (Array Std.U8 40#usize))
  := do
  let n ← itoa_core.digit_count v
  let buf1 ←
    if v < 10000#u64
    then do
         let i ← lift (UScalar.cast .U32 v)
         itoa_core.put4 buf 36#usize i
    else
      if v < 100000000#u64
      then
        do
        let i ← lift (UScalar.cast .U32 v)
        itoa_core.put8 buf 32#usize i
      else
        if v < 10000000000000000#u64
        then itoa_core.put16 buf 24#usize v
        else
          do
          let rest ← v % 10000000000000000#u64
          let i ← v / 10000000000000000#u64
          let top ← lift (UScalar.cast .U32 i)
          let buf2 ← itoa_core.put4 buf 20#usize top
          itoa_core.put16 buf2 24#usize rest
  let i ← itoa_core.BUF_LEN - n
  ok (i, buf1)

