def float_core.dec_f64
  (mant : Std.U64) (exp : Std.U32) (tie_even : Bool) :
  Result (Std.U64 × Std.I32)
  := do
  if exp = 0#u32
  then
    let i ← 1#u64 <<< 52#i32
    float_core.shortest mant (-1074)#i32 i (-1074)#i32 tie_even
  else
    let i ← 1#u64 <<< 52#i32
    let i1 ← lift (mant ||| i)
    let i2 ← lift (UScalar.hcast .I32 exp)
    let i3 ← i2 - 1075#i32
    float_core.shortest i1 i3 i (-1074)#i32 tie_even

