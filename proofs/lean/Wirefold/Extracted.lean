def float_core.dec_f32
  (mant : Std.U32) (exp : Std.U32) (tie_even : Bool) :
  Result (Std.U64 × Std.I32)
  := do
  if exp = 0#u32
  then
    let i ← lift (UScalar.cast .U64 mant)
    let i1 ← 1#u64 <<< 23#i32
    float_core.shortest i (-149)#i32 i1 (-149)#i32 tie_even
  else
    let i ← 1#u32 <<< 23#i32
    let i1 ← lift (mant ||| i)
    let i2 ← lift (UScalar.cast .U64 i1)
    let i3 ← lift (UScalar.hcast .I32 exp)
    let i4 ← i3 - 150#i32
    let i5 ← 1#u64 <<< 23#i32
    float_core.shortest i2 i4 i5 (-149)#i32 tie_even

