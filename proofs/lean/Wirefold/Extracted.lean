  let buf1 ← Array.update buf «at» i4
  let i5 ← hi + 1#usize
  let i6 ← Array.index_usize itoa_core.PAIRS i5
  let i7 ← «at» + 1#usize
  let buf2 ← Array.update buf1 i7 i6
  let i8 ← Array.index_usize itoa_core.PAIRS lo
  let i9 ← «at» + 2#usize
  let buf3 ← Array.update buf2 i9 i8
  let i10 ← lo + 1#usize
  let i11 ← Array.index_usize itoa_core.PAIRS i10
  let i12 ← «at» + 3#usize
  Array.update buf3 i12 i11

